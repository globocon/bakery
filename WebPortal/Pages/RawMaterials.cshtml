@page
@model WebPortal.Pages.RawMaterialsModel
@{
    ViewData["Title"] = "Ingredients";
    Layout = "_Layout";
}

@Html.AntiForgeryToken()

@section PageHeaders {
    
}

<!--breadcrumb-->
<div class="page-breadcrumb d-none d-sm-flex align-items-center mb-3">
    <div class="breadcrumb-title pe-3">BMS</div>
    <div class="ps-3">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 p-0">
                <li class="breadcrumb-item">
                    <a href="/"><i class="bx bx-home-alt"></i></a>
                </li>
                <li class="breadcrumb-item" aria-current="page">Product Management</li>
                <li class="breadcrumb-item active" aria-current="page">Ingredients</li>
            </ol>
        </nav>
    </div>
</div>
<!--end breadcrumb-->

<div class="row">
    <div class="col-xl-12 mx-auto">
        <div class="card border-top border-0 border-4 border-primary">
            <div class="card-body p-5">
                <div class="card-title d-flex align-items-center">
                    <div>
                        <i class="bx bx-cube me-1 font-22 text-primary"></i>
                    </div>
                    <h5 class="mb-0 text-primary">Ingredients List</h5>
                    <button id="btn_add_ingredient" type="button" class="btn btn-success btn-sm ms-auto"><i class="bx bx-plus me-0"></i>Add Ingredient</button>
                </div>
                <hr>
                <div class="table-responsive">
                    <table id="ingredientsTable" class="table table-striped table-bordered" style="width:100%">
                        <thead class="table-primary">
                        </thead>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Add Edit Ingredient modal -->
<div class="modal fade" id="EditIngredientModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <i class="bx bxs-cube me-1 font-22 text-primary"></i>
                </div>
                <h5 class="modal-title" id="addEditModalTitle"><i class="fa fa-bar-chart text-primary"></i> Edit Ingredient</h5>
                <button id="btn-modal-editingredient-menu-close" type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="frmMdlEditIngredient" name="frmMdlEditIngredient" class="needs-validation" novalidate>
                    <input id="IngredientAddEditModal_Id" name="IngredientAddEditModal.Id" hidden />
                    <div class="form-group row m-0 mb-2 g-2">
                        <div class="col-sm-12">
                            <label for="txbx_modal_editingredient_Name" class="ml-3 col-form-label">Ingredient</label>
                            <input class="form-control" type="text" id="IngredientAddEditModal_IngredientName" name="IngredientAddEditModal.IngredientName" placeholder="Ingredient Name" required />
                            <div class="invalid-feedback">Ingredient Name is required.</div>
                        </div>
                        <div class="col-md-4">
                            <label for="txbx_modal_editingredient_mrp" class="ml-3 col-form-label">Cost Price</label>
                            <input class="form-control" type="number" id="IngredientAddEditModal_CP" name="IngredientAddEditModal.CP" placeholder="Enter Cost" required />
                            <div class="invalid-feedback">Cost is required.</div>
                        </div>
                        <div class="col-md-8">
                            <input id="IngredientAddEditModal_UOM" name="IngredientAddEditModal.UOM" hidden />
                            <label for="select_modal_editingredient_uom" class="form-label" style="padding-top:6px">UOM</label>
                            <select id="select_modal_editingredient_uom" class="single-select-editingredient form-select" required>
                                <option value="">-- Select UOM --</option>
                                @foreach (var uom in Model.UomMasters)
                                {
                                    <option value="@uom.UOMName.ToLower()">@uom.UOMName</option>
                                }
                            </select>
                            <div class="invalid-feedback">UOM is required.</div>
                        </div>
                        <div class="col-md-6">
                            <label for="IngredientAddEditModal_SysStockQty" class="ml-3 col-form-label">System Stock Quantity</label>
                            <input class="form-control" type="number" id="IngredientAddEditModal_SysStockQty" name="IngredientAddEditModal.SysStockQty" min="0" placeholder="System Stock Qty" disabled />
                            <div class="invalid-feedback">Stock Quantity is required.</div>
                        </div>
                        <div class="col-md-6">
                            <label for="IngredientAddEditModal_PhyStockQty" class="ml-3 col-form-label">Physical Stock Quantity</label>
                            <input class="form-control" type="number" id="IngredientAddEditModal_PhyStockQty" name="IngredientAddEditModal.PhyStockQty" min="0" step="0.001"  placeholder="Enter Stock Qty" required />
                            <div class="invalid-feedback">Stock Quantity is required.</div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <input type="hidden" id="IngredientAddEditModal_Operation" value="ADD" />
                <button id="btn_modal_editingredient_save" type="button" class="btn btn-success btn-sm btn-validate">Save</button>
                <button id="btn_modal_editingredient_close" type="button" class="btn btn-danger btn-sm" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {

    <script src="~/assets/js/ingredients.js" asp-append-version="true"></script>
}
