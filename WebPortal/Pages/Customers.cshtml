@page
@model WebPortal.Pages.CustomersModel
@{
	ViewData["Title"] = "Customers";
}
@Html.AntiForgeryToken()

@section PageHeaders {
	<link href="~/assets/plugins/Drag-And-Drop/dist/imageuploadify.min.css" rel="stylesheet" />
}

<!--breadcrumb-->
<div class="page-breadcrumb d-none d-sm-flex align-items-center mb-3">
	<div class="breadcrumb-title pe-3">BMS</div>
	<div class="ps-3">
		<nav aria-label="breadcrumb">
			<ol class="breadcrumb mb-0 p-0">
				<li class="breadcrumb-item">
					<a href="/"><i class="bx bx-home-alt"></i></a>
				</li>
				<li class="breadcrumb-item active" aria-current="page">Customers</li>
			</ol>
		</nav>
	</div>
</div>
<!--end breadcrumb-->

<div class="row">
	<div class="col-xl-12 mx-auto">
		<div class="card border-top border-0 border-4 border-primary">
			<div class="card-body p-5">
				<div class="card-title d-flex align-items-center">
					<div>
						<i class="bx bx-cube me-1 font-22 text-primary"></i>
					</div>
					<h5 class="mb-0 text-primary">Customer List</h5>
					<button id="btn_add_customer" type="button" class="btn btn-success btn-sm ms-auto"><i class="bx bx-plus me-0"></i>New Customer</button>
				</div>
				<hr>
				<div class="table-responsive mt-4">
					<table id="customerTable" class="table table-striped table-bordered" style="width:100%">
						<thead class="table-primary">
						</thead>
					</table>
				</div>
			</div>
		</div>
	</div>
</div>

<!-- Add Edit Customer modal -->
<div class="modal fade" id="EditCustomerModal" tabindex="-1" aria-hidden="true">
	<div class="modal-dialog modal-dialog-centered  modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <i class="bx bxs-cube me-1 font-22 text-primary"></i>
                </div>
                <h5 class="modal-title" id="addEditModalTitle"><i class="fa fa-bar-chart text-primary"></i> Edit Customer</h5>
                <button id="btn-modal-editcustomer-menu-close" type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body bg-light">
				<form id="frmMdlEditCustomer" name="frmMdlEditCustomer" enctype="multipart/form-data" class="needs-validation" novalidate>
					<input id="CustomerAddEditModal_CustomerId" name="CustomerAddEditModal.CustomerId" hidden />
					<input id="CustomerAddEditModal_ImgFileExtn" name="CustomerAddEditModal.ImgFileExtn" hidden />
                    <div class="form-group row m-0 mb-2 g-2">
						<div class="col-lg-4">
							<div class="card">
								<div class="card-body">
									<div class="d-flex flex-column align-items-center text-center">
										<img src="assets/images/avatars/NoCustomerImage.jpg" alt="Admin" class="rounded-circle p-1 bg-primary" width="110">
										<div class="mt-3">
											<h4 id="Customer_Name">X</h4>							
										</div>
									</div>									
								</div>
							</div>							
						</div>
						<div class="col-lg-8">
							<div class="card">
								<div class="card-body">
									<div class="row mb-3">
										<div class="col-sm-3">
											<h6 class="mb-0">Full Name</h6>
										</div>
										<div class="col-sm-9 text-secondary">
											<input class="form-control" type="text" id="CustomerAddEditModal_Name" name="CustomerAddEditModal.Name" placeholder="Customer Name" required />
											<div class="invalid-feedback">Customer Name is required.</div>
										</div>
									</div>
									<div class="row mb-3">
										<div class="col-sm-3">
											<h6 class="mb-0">Email</h6>
										</div>
										<div class="col-sm-9 text-secondary">
											<input type="text" id="CustomerAddEditModal_Email" name="CustomerAddEditModal.Email" class="form-control" />
										</div>
									</div>
									<div class="row mb-3">
										<div class="col-sm-3">
											<h6 class="mb-0">Phone</h6>
										</div>
										<div class="col-sm-9 text-secondary">
											<input type="text" id="CustomerAddEditModal_Phone" name="CustomerAddEditModal.Phone" class="form-control"/>
										</div>
									</div>
									<div class="row mb-3">
										<div class="col-sm-3">
											<h6 class="mb-0">GST NO:</h6>
										</div>
										<div class="col-sm-9 text-secondary">
											<input type="text" id="CustomerAddEditModal_GSTNo" name="CustomerAddEditModal.GSTNo" class="form-control"/>
										</div>
									</div>
									<div class="row mb-3">
										<div class="col-sm-3">
											<h6 class="mb-0">Address</h6>
										</div>
										<div class="col-sm-9 text-secondary">
											<textarea id="CustomerAddEditModal_Address" name="CustomerAddEditModal.Address" type="text" class="form-control" rows="3"></textarea>
										</div>
									</div>	
									<div class="row mb-3">
										<div class="col-sm-3">
											<h6 class="mb-0">Image</h6>
										</div>
										<div class="col-sm-9">
											<input id="image-uploadify" type="file" accept="image/*" >
										</div>
									</div>
								</div>
							</div>							
						</div>						
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <input type="hidden" id="CustomerAddEditModal_Operation" value="ADD" />
                <button id="btn_modal_editcustomer_save" type="button" class="btn btn-success btn-sm btn-validate">Save</button>
                <button id="btn_modal_editcustomer_close" type="button" class="btn btn-danger btn-sm" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
	<script src="~/assets/plugins/Drag-And-Drop/dist/imageuploadify.min.js"></script>
	<script src="~/assets/js/customers.js" asp-append-version="true"></script>
	
}