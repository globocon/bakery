@page
@model WebPortal.Pages.TeamsModel
@{
	ViewData["Title"] = "Teams";
	Layout = "_Layout";
}
@Html.AntiForgeryToken()


<!--breadcrumb-->
<div class="page-breadcrumb d-none d-sm-flex align-items-center mb-3">
	<div class="breadcrumb-title pe-3">BMS</div>
	<div class="ps-3">
		<nav aria-label="breadcrumb">
			<ol class="breadcrumb mb-0 p-0">
				<li class="breadcrumb-item">
					<a href="/"><i class="bx bx-home-alt"></i></a>
				</li>
				<li class="breadcrumb-item active" aria-current="page">Teams</li>
			</ol>
		</nav>
	</div>
</div>
<!--end breadcrumb-->

<div class="row">
	<div class="col-xl-12 mx-auto">
		<div class="card border-top border-0 border-4 border-primary">
			<div class="card-body p-5">
				<div class="card-title d-flex align-items-center">
					<div>
						<i class="bx bx-right-arrow-alt me-1 font-22 text-primary"></i>
					</div>
					<h5 class="mb-0 text-primary">Team List</h5>
					<button id="btn_add_team" type="button" class="btn btn-success btn-sm ms-auto"><i class="bx bx-plus me-0"></i>Add Team</button>
				</div>
				<hr>
				<div class="table-responsive">
					<table id="teamTable" class="table table-striped table-bordered" style="width:100%">
						<thead class="table-primary">
						</thead>
					</table>
				</div>
			</div>
		</div>
	</div>
</div>


<!-- Add Edit Team modal -->
<div class="modal fade" id="EditTeamModal" tabindex="-1" aria-hidden="true">
	<div class="modal-dialog modal-dialog-centered">
		<div class="modal-content">
			<div class="modal-header">
				<div>
					<i class="bx bxs-cube me-1 font-22 text-primary"></i>
				</div>
				<h5 class="modal-title" id="addEditTeamModalTitle"><i class="fa fa-bar-chart text-primary"></i>Edit Team</h5>
				<button id="btn-modal-editteam-menu-close" type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<div class="modal-body">
				<form id="frmMdlEditTeam" name="frmMdlEditTeam" class="needs-validation" novalidate>
					<input id="PreparationTeamAddEditModal_Id" name="PreparationTeamAddEditModal.Id" hidden />
					<div class="form-group row m-0 mb-2 g-3">
						<div class="col-sm-12">
							<label for="PreparationTeamAddEditModal_Name" class="ml-3 col-form-label">Team</label>
							<input class="form-control" type="text" id="PreparationTeamAddEditModal_TeamName" name="PreparationTeamAddEditModal.TeamName" placeholder="Team Name" required />
							<div class="invalid-feedback">Team is required.</div>
						</div>
					</div>
				</form>
			</div>
			<div class="modal-footer">
				<input type="hidden" id="PreparationTeamAddEditModal_Operation" value="ADD" />
				<button id="btn_modal_editteam_save" type="button" class="btn btn-success btn-sm btn-validate">Save</button>
				<button id="btn_modal_editteam_close" type="button" class="btn btn-danger btn-sm" data-bs-dismiss="modal">Close</button>
			</div>
		</div>
	</div>
</div>

@section Scripts {
	<script src="~/assets/js/preparationteam.js" asp-append-version="true"></script>
}
